# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=commerce_agent
POSTGRES_PORT=5432
API_PORT=8000

# SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/commerce_agent

# LLM (Ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_MODELS=llama3.1:8b,gemma4:26b
PIPELINE_MODEL=llama3.1:8b
WEB_SEARCH_MODEL=gemma4:26b
OLLAMA_HOST=http://host.docker.internal:11434

# External services
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=commerce-agent

# Kaggle ingestion
KAGGLE_DATASET_HANDLE=lokeshparab/amazon-products-dataset
KAGGLE_NROWS=50000
