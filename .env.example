# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=commerce_agent
POSTGRES_PORT=5432

# SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/commerce_agent

# LLM (Ollama)
OLLAMA_MODEL=llama3.1:8b

# Kaggle ingestion
KAGGLE_DATASET_HANDLE=lokeshparab/amazon-products-dataset
KAGGLE_NROWS=50000
